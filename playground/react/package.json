{
  "name": "@i18n-playground/react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "i18n:check": "pnpm --filter @10coding/i18n-llm-trans-cli build && i18n-llm-trans check",
    "i18n:check:source": "pnpm --filter @10coding/i18n-llm-trans-cli build && i18n-llm-trans check --source",
    "i18n:check:target": "pnpm --filter @10coding/i18n-llm-trans-cli build && i18n-llm-trans check --target",
    "i18n:fix": "pnpm --filter @10coding/i18n-llm-trans-cli build && i18n-llm-trans check --add --add-target --remove",
    "i18n:trans": "pnpm --filter @10coding/i18n-llm-trans-cli build && i18n-llm-trans trans"
  },
  "dependencies": {
    "i18next": "^27.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.0"
  },
  "devDependencies": {
    "@10coding/i18n-llm-trans-cli": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
