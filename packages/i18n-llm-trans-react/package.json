{
  "name": "@10coding/i18n-llm-trans-react",
  "version": "0.1.0",
  "description": "React runtime for Chinese-key i18n with __TRANS_ID one-source-multiple-translations support, built on i18next.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "keywords": [
    "i18n",
    "react",
    "i18next",
    "react-i18next",
    "chinese-key",
    "translation"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "i18next": ">=23",
    "react": ">=18",
    "react-i18next": ">=15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "i18next": "^27.0.1",
    "react": "^19.3.1",
    "react-i18next": "^18.0.0",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
