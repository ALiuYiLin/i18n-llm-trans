{
  "name": "@10coding/i18n-trans",
  "version": "0.1.1",
  "description": "CLI that scans t() calls and keeps source-text-key locale files complete, with optional LLM translation.",
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "translation",
    "translate",
    "cli",
    "llm",
    "openai",
    "babel",
    "i18next",
    "vue-i18n",
    "locale",
    "json",
    "source-text-key",
    "trans-id"
  ],
  "author": "ALiuYiLin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALiuYiLin/i18n-llm-trans.git",
    "directory": "packages/i18n-trans"
  },
  "homepage": "https://github.com/ALiuYiLin/i18n-llm-trans/tree/master/packages/i18n-trans#readme",
  "bugs": {
    "url": "https://github.com/ALiuYiLin/i18n-llm-trans/issues"
  },
  "type": "module",
  "files": [
    "bin.js",
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "bin": {
    "i18n-trans": "./bin.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
