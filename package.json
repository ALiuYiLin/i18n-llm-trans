{
  "name": "i18n-llm-trans",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vite + TypeScript monorepo with a publishable React i18n runtime and Vue/React playgrounds.",
  "scripts": {
    "dev:vue": "pnpm --filter @i18n-playground/vue dev",
    "dev:react": "pnpm --filter @i18n-playground/react dev",
    "build": "pnpm -r build",
    "build:vue": "pnpm --filter @i18n-playground/vue build",
    "build:react": "pnpm --filter @i18n-playground/react build",
    "build:cli": "pnpm --filter @10coding/i18n-llm-trans-cli build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @10coding/i18n-llm-trans-cli test",
    "i18n:check": "pnpm --filter @i18n-playground/react i18n:check",
    "i18n:check:source": "pnpm --filter @i18n-playground/react i18n:check:source",
    "i18n:check:target": "pnpm --filter @i18n-playground/react i18n:check:target",
    "i18n:fix": "pnpm --filter @i18n-playground/react i18n:fix",
    "i18n:trans": "pnpm --filter @i18n-playground/react i18n:trans",
    "preview:vue": "pnpm --filter @i18n-playground/vue preview",
    "preview:react": "pnpm --filter @i18n-playground/react preview"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
